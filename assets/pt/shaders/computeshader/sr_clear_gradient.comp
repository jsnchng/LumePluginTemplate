#version 460 core
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

layout(set = 0, binding = 0, rgba32f) uniform image2D uLRGradient;
layout(set = 0, binding = 1, rgba32f) uniform image2D uLossOutput;
layout(set = 0, binding = 2, rgba32f) uniform image2D uPredictedColorOutput;
layout(set = 0, binding = 3, r11f_g11f_b10f) uniform image2D uPredictedBaseColor;
layout(set = 0, binding = 4, rgba32f) uniform image2D uDLossDSampledTexture;
layout(set = 0, binding = 5, rgba32f) uniform image2D uLRMomentum1;
layout(set = 0, binding = 6, rgba32f) uniform image2D uLRMomentum2;
layout(set = 0, binding = 7, std430) buffer LRGradientSsbo {
    int uLRGradientSsbo[];
};

layout(push_constant) uniform PushConstants {
    uint shouldClearBuffers;  // 1 = clear all buffers, 0 = only clear gradient
    uint gtWidth;
    uint gtHeight;
} pc;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    ivec2 destCoord = ivec2(gl_GlobalInvocationID.xy);
    
    // Always clear gradient buffer (used every frame)
    ivec2 gradientSize = imageSize(uLRGradient);
    if (destCoord.x < gradientSize.x && destCoord.y < gradientSize.y) {
        imageStore(uLRGradient, destCoord, vec4(0.0));
        uint idx = (uint(destCoord.y) * uint(gradientSize.x) + uint(destCoord.x)) * 4u;
        uLRGradientSsbo[idx + 0u] = 0;
        uLRGradientSsbo[idx + 1u] = 0;
        uLRGradientSsbo[idx + 2u] = 0;
        uLRGradientSsbo[idx + 3u] = 0;
    }
    
    // If view switched, clear all other buffers too
    if (pc.shouldClearBuffers == 1u) {
        // Clear loss output (GT size)
        if (destCoord.x < pc.gtWidth && destCoord.y < pc.gtHeight) {
            imageStore(uLossOutput, destCoord, vec4(0.0));
            imageStore(uPredictedColorOutput, destCoord, vec4(0.0));
            imageStore(uPredictedBaseColor, destCoord, vec4(0.0));
            imageStore(uDLossDSampledTexture, destCoord, vec4(0.0));
        }
        
        // Clear momentum buffers (LR size)
        ivec2 momentumSize = imageSize(uLRMomentum1);
        if (destCoord.x < momentumSize.x && destCoord.y < momentumSize.y) {
            imageStore(uLRMomentum1, destCoord, vec4(0.0));
            imageStore(uLRMomentum2, destCoord, vec4(0.0));
        }
    }
}
