#version 460 core
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

layout(set = 0, binding = 0, rgba32f) uniform image2D uTexture;
layout(set = 0, binding = 1, rgba32f) uniform image2D uGradient;
layout(set = 0, binding = 2, rgba32f) uniform image2D uMomentum1;
layout(set = 0, binding = 3, rgba32f) uniform image2D uMomentum2;
layout(set = 0, binding = 4, std430) buffer LRGradientSsbo {
    int uLRGradientSsbo[];
};

const float GRADIENT_ATOMIC_SCALE = 4096.0;

float decodeGradientFromAtomic(int value)
{
    return float(value) / GRADIENT_ATOMIC_SCALE;
}

layout(push_constant, std430) uniform uPushConstant {
    float learningRate;
    float beta1;
    float beta2;
    float epsilon;
    int iteration;
};

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 textureSizeValue = imageSize(uTexture);
    if (coord.x >= textureSizeValue.x || coord.y >= textureSizeValue.y) {
        return;
    }

    vec4 value = imageLoad(uTexture, coord);
    uint gradIdx = (uint(coord.y) * uint(textureSizeValue.x) + uint(coord.x)) * 4u;
    vec4 grad = vec4(
        decodeGradientFromAtomic(uLRGradientSsbo[gradIdx + 0u]),
        decodeGradientFromAtomic(uLRGradientSsbo[gradIdx + 1u]),
        decodeGradientFromAtomic(uLRGradientSsbo[gradIdx + 2u]),
        decodeGradientFromAtomic(uLRGradientSsbo[gradIdx + 3u]));
    vec4 m1 = imageLoad(uMomentum1, coord);
    vec4 m2 = imageLoad(uMomentum2, coord);

    m1 = beta1 * m1 + (1.0 - beta1) * grad;
    m2 = beta2 * m2 + (1.0 - beta2) * (grad * grad);

    float biasCorrection1 = 1.0 - pow(beta1, float(iteration));
    float biasCorrection2 = 1.0 - pow(beta2, float(iteration));

    vec4 m1Hat = m1 / biasCorrection1;
    vec4 m2Hat = m2 / biasCorrection2;
    value = value - learningRate * m1Hat / (sqrt(m2Hat) + vec4(epsilon));
    value = clamp(value, 0.0, 1.0);

    imageStore(uTexture, coord, value);
    imageStore(uGradient, coord, grad);
    imageStore(uMomentum1, coord, m1);
    imageStore(uMomentum2, coord, m2);
}
