#version 460 core
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

// ============================================================================
// Super-Resolution Differentiable Render - Simplified PBR Version
// ============================================================================

// G-Buffer inputs (set 0, binding 0-4)
layout(set = 0, binding = 0) uniform texture2D uDepthBuffer;
layout(set = 0, binding = 1) uniform texture2D uNormalBuffer;
layout(set = 0, binding = 2) uniform texture2D uMaterialBuffer;
layout(set = 0, binding = 3) uniform texture2D uUVBuffer;
layout(set = 0, binding = 4) uniform texture2D uBaseColorBuffer;  // For downsample init

// LR texture (set 0, binding 5)
layout(set = 0, binding = 5) uniform texture2D uLRTexture;

// Sampler (set 0, binding 6)
layout(set = 0, binding = 6) uniform sampler uSampler;

// Output images
layout(set = 0, binding = 8, r32f) uniform image2D uLossOutput;

// GT image (set 0, binding 9)
layout(set = 0, binding = 9) uniform texture2D uGTImage;

// Debug Output (set 0, binding 10)
layout(set = 0, binding = 10, rgba32f) uniform image2D debugOutput;

// Predicted Base Color (set 0, binding 11)
layout(set = 0, binding = 11, r11f_g11f_b10f) uniform image2D predictedBaseColor;

// dL_dBaseColor (set 0, binding 12)
layout(set = 0, binding = 12, rgba32f) uniform image2D dL_dBaseColor_buffer;

// Authoritative LR gradient storage. Values are packed as fixed-point RGBA int per LR texel.
layout(set = 0, binding = 13, std430) buffer LRGradientSsbo {
    int uLRGradientSsbo[];
};

// Push Constants
layout(push_constant, std430) uniform uPushConstant {
    uint gtWidth;
    uint gtHeight;
    uint lrWidth;
    uint lrHeight;
    
    // Light direction (view space)
    vec3 lightDir;
    
    uint useUVBuffer;
    
    // Light color
    vec3 lightColor;
    float lossScale;
    
    // Camera position (world space)
    vec3 cameraPos;
    float _pad2;
    
    // View-Projection Inverse matrix
    mat4 viewProjInv;
};

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ================================================================
// Bilinear sampling and gradient accumulation
// ================================================================
vec4 sanitizeGradient(vec4 grad) {
    if (any(isnan(grad)) || any(isinf(grad))) {
        return vec4(0.0);
    }
    return clamp(grad, vec4(-5.0), vec4(5.0));
}

const float GRADIENT_ATOMIC_SCALE = 4096.0;
const float GRADIENT_ATOMIC_LIMIT = 2147480000.0;

int encodeGradientForAtomic(float value) {
    float scaled = round(value * GRADIENT_ATOMIC_SCALE);
    return int(clamp(scaled, -GRADIENT_ATOMIC_LIMIT, GRADIENT_ATOMIC_LIMIT));
}

void accumulateGradient(vec2 uv, vec4 dL_dBaseColor) {
    dL_dBaseColor = sanitizeGradient(dL_dBaseColor);
    if (dot(dL_dBaseColor, dL_dBaseColor) == 0.0) return;

    uv = fract(uv); // Since sampler is on repeat mode

    vec2 texCoord = uv * vec2(lrWidth, lrHeight) - 0.5;
    ivec2 texel00 = ivec2(floor(texCoord));
    
    vec2 f = fract(texCoord);
    vec4 weights = vec4(
        (1.0 - f.x) * (1.0 - f.y),
        f.x * (1.0 - f.y),
        (1.0 - f.x) * f.y,
        f.x * f.y
    );
    
    texel00 = clamp(texel00, ivec2(0), ivec2(lrWidth - 1, lrHeight - 1));
    ivec2 texel10 = clamp(ivec2(texel00.x + 1, texel00.y), ivec2(0), ivec2(lrWidth - 1, lrHeight - 1));
    ivec2 texel01 = clamp(ivec2(texel00.x, texel00.y + 1), ivec2(0), ivec2(lrWidth - 1, lrHeight - 1));
    ivec2 texel11 = clamp(ivec2(texel00.x + 1, texel00.y + 1), ivec2(0), ivec2(lrWidth - 1, lrHeight - 1));
    
    uint idx00 = (uint(texel00.y) * lrWidth + uint(texel00.x)) * 4u;
    uint idx10 = (uint(texel10.y) * lrWidth + uint(texel10.x)) * 4u;
    uint idx01 = (uint(texel01.y) * lrWidth + uint(texel01.x)) * 4u;
    uint idx11 = (uint(texel11.y) * lrWidth + uint(texel11.x)) * 4u;

    vec4 g00 = weights.x * dL_dBaseColor;
    vec4 g10 = weights.y * dL_dBaseColor;
    vec4 g01 = weights.z * dL_dBaseColor;
    vec4 g11 = weights.w * dL_dBaseColor;

    atomicAdd(uLRGradientSsbo[idx00 + 0u], encodeGradientForAtomic(g00.r));
    atomicAdd(uLRGradientSsbo[idx00 + 1u], encodeGradientForAtomic(g00.g));
    atomicAdd(uLRGradientSsbo[idx00 + 2u], encodeGradientForAtomic(g00.b));
    atomicAdd(uLRGradientSsbo[idx00 + 3u], encodeGradientForAtomic(g00.a));

    atomicAdd(uLRGradientSsbo[idx10 + 0u], encodeGradientForAtomic(g10.r));
    atomicAdd(uLRGradientSsbo[idx10 + 1u], encodeGradientForAtomic(g10.g));
    atomicAdd(uLRGradientSsbo[idx10 + 2u], encodeGradientForAtomic(g10.b));
    atomicAdd(uLRGradientSsbo[idx10 + 3u], encodeGradientForAtomic(g10.a));

    atomicAdd(uLRGradientSsbo[idx01 + 0u], encodeGradientForAtomic(g01.r));
    atomicAdd(uLRGradientSsbo[idx01 + 1u], encodeGradientForAtomic(g01.g));
    atomicAdd(uLRGradientSsbo[idx01 + 2u], encodeGradientForAtomic(g01.b));
    atomicAdd(uLRGradientSsbo[idx01 + 3u], encodeGradientForAtomic(g01.a));

    atomicAdd(uLRGradientSsbo[idx11 + 0u], encodeGradientForAtomic(g11.r));
    atomicAdd(uLRGradientSsbo[idx11 + 1u], encodeGradientForAtomic(g11.g));
    atomicAdd(uLRGradientSsbo[idx11 + 2u], encodeGradientForAtomic(g11.b));
    atomicAdd(uLRGradientSsbo[idx11 + 3u], encodeGradientForAtomic(g11.a));
}

// ================================================================
// Main
// ================================================================
void main() {

    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    
    if (pixelCoord.x >= int(gtWidth) || pixelCoord.y >= int(gtHeight)) {
        return;
    }
    
    vec2 screenUV = (vec2(pixelCoord) + 0.5) / vec2(gtWidth, gtHeight);
    
    // Step 1: Read G-Buffer
    float depth = textureLod(sampler2D(uDepthBuffer, uSampler), screenUV, 0.0).r;
    


    // Skip background pixels
    if (depth >= 1.0) {
        return;
    }
    

    
    // Step 2: Get UV for texture sampling
    vec2 texUV;
    if (useUVBuffer != 0u) {
        vec4 uvData = textureLod(sampler2D(uUVBuffer, uSampler), screenUV, 0.0);
        texUV = uvData.xy;
    } else {
        texUV = screenUV;
    }

    // 我们将反向传播提前到deferred shading阶段，并直接将结果存入缓冲区
    vec3 dL_dBaseColor = imageLoad(dL_dBaseColor_buffer, pixelCoord).rgb;

    // Step 9: Accumulate gradient
    // 由于我们把反向传播提前了，所以直接把dL_dBaseColor累加到对应的texel即可
    accumulateGradient(texUV, vec4(dL_dBaseColor, 0.0));

    // Debug Output
    vec3 testColor = imageLoad(predictedBaseColor, pixelCoord).rgb;
    vec4 debugColor = vec4(testColor, 1.0);
    imageStore(debugOutput, pixelCoord, debugColor);

    
}
