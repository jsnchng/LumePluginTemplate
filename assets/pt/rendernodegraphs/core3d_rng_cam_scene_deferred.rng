{
    "compatibility_info": {
        "version": "22.00",
        "type": "rendernodegraph"
    },
    "renderNodeGraphName": "",
    "nodes": [
        {
            "typeName": "RenderNodeMaskUbo",
            "nodeName": "MASK_UBO_NODE",
            "custom": {
                "maskValue": 16,
                "bufferShareName": "mask_ubo_buffer"
            }
        },
        {
            "typeName": "RenderNodeCreateGpuBuffers",
            "nodeName": "RenderNodeCreateGpuBuffers",
            "gpuBufferDescs": [
                {
                    "name": "BufferTarget",
                    "shareName": "MyBufferTarget",
                    "usageFlags": "transfer_src | transfer_dst | uniform | storage | index | vertex | indirect",
                    "memoryPropertyFlags": "device_local",
